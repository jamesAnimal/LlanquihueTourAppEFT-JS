<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.llanquihuetour.ui.VentanaReservas">
  <grid id="27dc6" binding="ventanaReservas" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="635" height="419"/>
